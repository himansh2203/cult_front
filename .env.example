# Local: http://localhost:4000. On Vercel set it to an EMPTY value so /api/* goes through the vercel.json proxy (first-party cookies).
VITE_API_BASE_URL=http://localhost:4000
# Socket.IO connects directly to the API host (Vercel rewrites do not proxy websockets). e.g. https://cult-back.onrender.com
VITE_SOCKET_URL=
# Dev-only fallback login when the API is offline. Never compiled into production builds.
VITE_ADMIN_LOGIN_ID=admin@cultfitness.local
VITE_ADMIN_PASSWORD=change-me-locally
